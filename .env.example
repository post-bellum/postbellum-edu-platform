# .env.example
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Schools registry data URL (Czech Ministry of Education) - REQUIRED
SCHOOLS_REGISTRY_URL=

# Public base URL of the deployment, e.g. https://storyon.cz - used to build
# absolute links in outgoing emails and CSV exports.
NEXT_PUBLIC_APP_URL=

# Improvement suggestions ("Poslat návrh na zlepšení") - sent via Resend.
RESEND_API_KEY=
SUGGESTIONS_EMAIL_TO=
SUGGESTIONS_EMAIL_FROM=

# Newsletter delivery via SmartEmailing (API v3). Supabase stays the source of
# truth - these credentials only push subscribers into the contact list.
# Username is the account e-mail, the key comes from Account Settings → API keys.
SMARTEMAILING_API_USER=
SMARTEMAILING_API_KEY=
SMARTEMAILING_CONTACTLIST_ID=

# Shared secret for /api/cron/smartemailing-sync (sent by Vercel Cron).
CRON_SECRET=

NEXT_PUBLIC_QA_EMAILS=qa@example.com,test@qa.example.com
NEXT_PUBLIC_QA_OTP_CODE=111111

# Optional: Set to enable browser password protection (shows native login prompt)
# PASSWORD_PROTECTION_PASSWORD=your-secret-password

# Optional: Set to enable coming soon mode (redirects all routes to /)
# COMING_SOON_MODE=false

# Optional: Umami analytics - only set in production
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=

